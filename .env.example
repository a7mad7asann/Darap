# ==============================================================================
# DARB Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or staging/production deployment.
# IMPORTANT: In production, all placeholders MUST be replaced with real, high-entropy secrets.

# ------------------------------------------------------------------------------
# 1. Environment & Server Ports
# ------------------------------------------------------------------------------
# Set to 'production' in deployed environments; 'development' for local work
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 2. Web Application & CORS Configuration
# ------------------------------------------------------------------------------
# Web application public URL (used for CORS allowlists, email links, and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public REST API entry point accessed by the web client
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional comma-separated list of additional allowed CORS origins in production
# e.g., CORS_ALLOWED_ORIGINS=https://darb.example.com,https://app.darb.example.com
# CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 3. Database Connection Configuration
# ------------------------------------------------------------------------------
# Primary migration connection URL (used by Prisma CLI for migrations; schema owner / superuser)
# In production, use your managed PostgreSQL connection string (AWS RDS / Neon / Supabase).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darb_dev?schema=public

# Application runtime connection URL (unprivileged role for PostgreSQL RLS tenant isolation)
# The application user must NOT have BYPASSRLS or SUPERUSER privileges.
# In local development without custom roles, this can match DATABASE_URL.
APP_DATABASE_URL=postgresql://darb_app:darb_app_secret@localhost:5432/darb_dev?schema=public

# ------------------------------------------------------------------------------
# 4. Security, Cookie & Session Secrets
# ------------------------------------------------------------------------------
# Secret key for signing session JWT tokens. Minimum 32 characters.
# CRITICAL FOR PRODUCTION: Generate using: openssl rand -base64 32
# The application will refuse to start in production if an insecure placeholder is used.
SESSION_SECRET=YOUR_SECURE_RANDOM_SESSION_SECRET_MIN_32_CHARS_PLACEHOLDER

# Cookie settings
COOKIE_NAME=darb_session
# CRITICAL: COOKIE_SECURE MUST be 'true' in production (requires HTTPS)
# In development (HTTP localhost), set to 'false'.
COOKIE_SECURE=false
# SameSite policy: 'lax' for same-domain or top-level redirects, 'strict' or 'none' (requires secure=true)
COOKIE_SAME_SITE=lax
# Session time-to-live in hours (default: 24)
SESSION_TTL_HOURS=24

# ------------------------------------------------------------------------------
# 5. Security & Rate Limiting Controls
# ------------------------------------------------------------------------------
# Sliding-window rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_TTL_MS=60000
# Maximum failed attempts within sliding window before locking IP (default: 5)
RATE_LIMIT_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 6. OpenAPI / Swagger Documentation
# ------------------------------------------------------------------------------
# Controls whether Swagger docs are mounted at /api/docs and /api/v1/docs.
# In development, defaults to true. In production, defaults to false for security.
ENABLE_SWAGGER=true

# ------------------------------------------------------------------------------
# 7. Managed Object Storage Configuration (S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
# Optional: S3-compatible storage bucket credentials for student worksheet uploads.
# S3_ENDPOINT=https://s3.region.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=YOUR_S3_BUCKET_NAME_PLACEHOLDER
# S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID_PLACEHOLDER
# S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY_PLACEHOLDER
