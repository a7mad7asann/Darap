# ==========================================
# DARB MVP Environment Configuration
# ==========================================
# Copy this file to .env for local development

NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Web Application URL (for CORS and Auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Backend & Database Configuration
# Main admin/migration connection (superuser or schema migration role)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darb_dev?schema=public

# Application connection (constrained role for RLS enforcement in staging/production)
# For local dev without custom roles, this can default to DATABASE_URL.
APP_DATABASE_URL=postgresql://darb_app:darb_app_secret@localhost:5432/darb_dev?schema=public

# Security & Session Secrets
# Generate random 32+ byte strings in production: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-very-secure-random-secret-at-least-32-chars
COOKIE_NAME=darb_session
COOKIE_SECURE=false # Set to 'true' in staging and production (HTTPS required)
COOKIE_SAME_SITE=lax
SESSION_TTL_HOURS=24

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=5

# Managed Object Storage (Future / Phase 2 ready)
# S3_ENDPOINT=https://s3.region.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=darb-files-dev
# S3_ACCESS_KEY_ID=placeholder
# S3_SECRET_ACCESS_KEY=placeholder
